# Resolve only package versions at least 3 days old, like Renovate's minimumReleaseAge. Renovate gates
# only the dependency it updates and lets npm resolve the rest of the tree, which this holds back too.
# Renovate defers to this setting and drops its own --before cutoff when it is present.
min-release-age=3
# The agent harnesses and Thurston's own packages take each release the day it ships.
min-release-age-exclude[]=@earendil-works/*
min-release-age-exclude[]=@anthropic-ai/claude-code
min-release-age-exclude[]=@anthropic-ai/claude-agent-sdk
min-release-age-exclude[]=@openai/codex
min-release-age-exclude[]=@openai/codex-sdk
min-release-age-exclude[]=@thurstonsand/*
min-release-age-exclude[]=pi-sessions
min-release-age-exclude[]=doppelclaude
min-release-age-exclude[]=http-doppelclaude
min-release-age-exclude[]=pi-doppelclaude
