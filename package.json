{
  "name": "@thurstonsand/pi-librarian",
  "version": "0.9.0",
  "type": "module",
  "description": "Code research subagent for pi: deep-dive repos and discover across GitHub, GitLab, Bitbucket Server, and Sourcegraph; plus web search and URL-native fetch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-librarian.git"
  },
  "homepage": "https://github.com/thurstonsand/pi-librarian#readme",
  "bugs": {
    "url": "https://github.com/thurstonsand/pi-librarian/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "librarian": "./dist/cli/librarian.js"
  },
  "files": [
    "dist",
    "plugin/agents",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "DEV.md",
    "AGENTS.md",
    "docs",
    "images"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/librarian.js"
    ]
  },
  "scripts": {
    "build": "mise run build",
    "prepack": "mise run build",
    "lint": "mise run lint",
    "format": "mise run format",
    "typecheck": "mise run typecheck",
    "test": "mise run test",
    "check": "mise run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^24.13.3",
    "tsdown": "^0.23.5",
    "typebox": "1.3.27",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.5.0",
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "playwright-core": "^1.64.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
