#!/bin/sh
# Claude Code puts this directory on PATH, so the librarian subagent runs the CLI from npm pinned
# to this plugin's own version. Only the subagent's prompt names it.
set -eu
plugin_json="$(dirname "$0")/../.claude-plugin/plugin.json"
version="$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "${plugin_json}")"
exec npx --yes "@thurstonsand/pi-librarian@${version}" "$@"
