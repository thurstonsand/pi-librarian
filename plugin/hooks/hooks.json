{
  "description": "Lets the librarian subagent run the librarian command and read its own cache without a permission prompt",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/permissions.mjs"]
          }
        ]
      }
    ]
  }
}
